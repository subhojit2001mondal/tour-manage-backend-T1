# GEMINI_API_KEY: Required for Gemini AI API calls (customer support chatbot).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Razorpay credentials for payment processing (Test mode keys)
RAZORPAY_KEY_ID="rzp_test_xxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Demo Payment Mode: set to "true" to allow test payments without live Razorpay orders
DEMO_PAYMENT_MODE="true"
